{"version": 2, "width": 100, "height": 30, "timestamp": 1785616711, "env": {"SHELL": "/bin/bash", "TERM": "tmux-256color"}}
[0.079865, "o", "\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1;36m  Hand an AI agent the keys to your cluster.\u001b[0m\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[0.880102, "o", "\u001b[1m\r\n  ▸ Every move it makes lands in a tamper-evident ledger — keyed, hash-chained, by default.\u001b[0m\r\n"]
[2.080203, "o", "\u001b[1m\r\n  ▸ Watch three things an agent did get written down, then watch the record defend itself.\u001b[0m\r\n"]
[5.280585, "o", "\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1;36m  1 / The agent acts. Proximo writes it down.\u001b[0m\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[6.0813, "o", "\r\n  \u001b[1;33mAI agent ▸\u001b[0m pve_guest_power  \u001b[2m{\"change\": \"stop lxc 931\", \"risk\": \"high\", \"risk_reasons\": [\"hard stop (power pull) of a running guest\"], \"blast_radius\": [\"1 running guest will halt (uptime 1d)\"]}\u001b[0m\r\n"]
[7.281952, "o", "\r\n  \u001b[1;33mAI agent ▸\u001b[0m pve_snapshot_create  \u001b[2m{\"change\": \"create snapshot pre-deploy of lxc 931\", \"risk\": \"low\", \"risk_reasons\": [\"additive \\u2014 creates a snapshot\"], \"blast_radius\": [\"adds a restore point (non-destructive)\"]}\u001b[0m\r\n"]
[8.482522, "o", "\r\n  \u001b[1;33mAI agent ▸\u001b[0m ct_exec  \u001b[2m{\"change\": \"run in 931: [redacted apt, 19 chars, sha256:2aabcc03b444]\", \"risk\": \"medium\", \"cmd_kind\": \"apt\", \"cmd_len\": 19, \"cmd_sha256\": \"2aabcc03b44475014399e2e18d2aac30da0abd33d417b445edf976b2de1e658a\"}\u001b[0m\r\n"]
[9.683295, "o", "\u001b[2m  proximo ▸ audit_verify()\u001b[0m\r\n    {\r\n"]
[9.803456, "o", "      \"ok\": true,\r\n"]
[9.923556, "o", "      \"entries\": 3,\r\n"]
[10.043696, "o", "      \"keyed\": true,\r\n"]
[10.16387, "o", "      \"head\": \"5a527314d803b0b32850d83a…\"\r\n"]
[10.284004, "o", "    }\r\n"]
[10.404168, "o", "\u001b[1m\r\n  ▸ Three actions, hash-chained. \u001b[1;32mok=True\u001b[0m, keyed=True. This is the receipt.\u001b[0m\r\n"]
[13.604537, "o", "\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1;36m  2 / Someone edits the log to hide a move.\u001b[0m\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[14.404775, "o", "\u001b[1m\r\n  ▸ An attacker (or a careless cleanup) rewrites one entry's detail, in place.\u001b[0m\r\n"]
[15.605624, "o", "\u001b[2m  proximo ▸ audit_verify()  (on the edited copy)\u001b[0m\r\n    {\r\n"]
[15.725728, "o", "      \"ok\": false,\r\n"]
[15.845818, "o", "      \"broken_at_line\": 2,\r\n"]
[15.965877, "o", "      \"reason\": \"entry_hash mismatch (entry altered)\"\r\n"]
[16.086088, "o", "    }\r\n"]
[16.206134, "o", "\u001b[1m\r\n  ▸ \u001b[1;31mok=False\u001b[0m — caught at line 2. You can't edit the past without breaking the chain.\u001b[0m\r\n"]
[19.406446, "o", "\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1;36m  3 / Someone deletes the tail to erase the last move.\u001b[0m\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[20.206674, "o", "\u001b[1m\r\n  ▸ The sneakiest attack: just truncate the file. A forward walk alone can't see what's gone —\u001b[0m\r\n"]
[21.406835, "o", "\u001b[1m\r\n  ▸ so you pin the head off-box. Proximo checks the live chain against the head you trust.\u001b[0m\r\n"]
[22.60754, "o", "\u001b[2m  proximo ▸ forward walk alone\u001b[0m\r\n    {\r\n"]
[22.727601, "o", "      \"ok\": true,\r\n"]
[22.847796, "o", "      \"reason\": null\r\n"]
[22.968018, "o", "    }\r\n"]
[23.088172, "o", "\u001b[2m  proximo ▸ verify(expected_head=…)  the off-box anchor\u001b[0m\r\n    {\r\n"]
[23.20836, "o", "      \"ok\": false,\r\n"]
[23.328594, "o", "      \"reason\": \"head mismatch (tail truncated/appended or file replaced)\"\r\n"]
[23.448765, "o", "    }\r\n"]
[23.568936, "o", "\u001b[1m\r\n  ▸ Forward walk says ok — but pinned against the trusted head: \u001b[1;31mok=False, head mismatch\u001b[0m.\u001b[0m\r\n"]
[24.769111, "o", "\u001b[1m\r\n  ▸ Tamper-EVIDENT, by construction. Hand over the keys; keep the receipts.\u001b[0m\r\n"]
[25.969226, "o", "\u001b[1;32m\r\n  Strength and honor.\r\n\u001b[0m\r\n"]
