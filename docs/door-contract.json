{
  "contract": 3,
  "about": "Proximo's MCP door as any client meets it: the six tools and the shapes their answers take. Generated by scripts/gen_door_contract.py; a change raises `contract` and the CHANGELOG says so. A release that leaves the number alone leaves the door alone.",
  "tools": [
    {
      "name": "proximo_find",
      "description": "READ-ONLY: find API addresses by plain words ('list datastores'). A verb picks the method. Returns access and blast-radius tier. 5 by default.",
      "inputSchema": {
        "properties": {
          "query": {
            "type": "string"
          },
          "plane": {
            "enum": [
              "pve",
              "pbs",
              "pmg",
              "pdm"
            ],
            "type": "string"
          },
          "limit": {
            "default": 5,
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "readOnlyHint": true
    },
    {
      "name": "proximo_plan",
      "description": "READ-ONLY, mutates nothing: the governed verdict (armed, tier, consent) for one address, with the parameters you gave and the required ones you lack; fields='name1,name2' or 'all' shows the vendor's full schema. A mutation's plan also reads the target: current, change, noop. Run before proximo_call. path may be words: one match is planned, several come back to pick from.",
      "inputSchema": {
        "properties": {
          "plane": {
            "enum": [
              "pve",
              "pbs",
              "pmg",
              "pdm"
            ],
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "args": {
            "type": "object"
          },
          "fields": {
            "type": "string"
          }
        },
        "required": [
          "plane",
          "method",
          "path"
        ],
        "type": "object"
      },
      "readOnlyHint": true
    },
    {
      "name": "proximo_read",
      "description": "READ-ONLY: run a GET by path or words (no leading slash). args = query parameters (params: old name). Rows come lean with a total; fields='all' or 'name,status' for others; over the cap you get counts and a next line. since='24h': what changed, from the door's snapshots. wait=N on .../tasks/{upid}/status waits up to N s (max 600). diagnose=true on a node or guest path: health and advisory flags. Credentials come back withheld.",
      "inputSchema": {
        "properties": {
          "plane": {
            "enum": [
              "pve",
              "pbs",
              "pmg",
              "pdm"
            ],
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "args": {
            "type": "object"
          },
          "fields": {
            "type": "string"
          },
          "since": {
            "type": "string"
          },
          "wait": {
            "type": "integer"
          },
          "diagnose": {
            "default": false,
            "type": "boolean"
          },
          "params": {
            "type": "object"
          }
        },
        "required": [
          "plane",
          "path"
        ],
        "type": "object"
      },
      "readOnlyHint": true
    },
    {
      "name": "proximo_call",
      "description": "MUTATION: run a governed POST/PUT/DELETE. Without confirm=true it returns the plan (verdict, consent id, current, change) and mutates nothing. Refused unless the operator is armed AND the address has an authored blast-radius tier. Every call, refused or executed, is receipted. Task-backed calls are waited on (wait=N s, default 60, max 600; 0 submits only). method=undo with path=<undo.id> puts a receipt's capture back, plan first; withheld or unpublished keys come back as skipped.",
      "inputSchema": {
        "properties": {
          "plane": {
            "enum": [
              "pve",
              "pbs",
              "pmg",
              "pdm"
            ],
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "args": {
            "type": "object"
          },
          "confirm": {
            "default": false,
            "type": "boolean"
          },
          "wait": {
            "type": "integer"
          }
        },
        "required": [
          "plane",
          "method",
          "path"
        ],
        "type": "object"
      },
      "readOnlyHint": false
    },
    {
      "name": "audit_entries",
      "description": "READ-ONLY: the PROVE ledger, newest first, bounded; says when it truncated.",
      "inputSchema": {
        "properties": {
          "limit": {
