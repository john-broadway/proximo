# Proximo configuration — copy to /etc/proximo/proximo.env (chmod 600).

# --- Management (Proxmox REST API) ---
PROXIMO_API_BASE_URL=https://pve.example.lan:8006/api2/json
PROXIMO_NODE=pve

# Path to a file containing exactly: USER@REALM!TOKENID=SECRET
# (run-but-not-read; chmod 600, owned by the proximo user)
PROXIMO_TOKEN_PATH=/etc/proximo/pve-token

# --- Exec (ssh -> pct) ---
# "pve" = remote via ssh host alias; "local" = on the PVE host (direct pct)
PROXIMO_SSH_TARGET=pve

# --- Doorway (what tools/list serves; context hygiene, not authorization) ---
# DEFAULT since 0.30: the dynamic facade (~1,740 tokens) — search/schema/read/call/recall + the
# audit pair resident; everything this box serves still callable through them.
# `catalog` = the pre-0.30 default (full schemas, auto-scoped to configured planes);
# `all` = the full surface; or name domain toolsets like pve.guests (see docs/SETUP.md).
#PROXIMO_TOOLSETS=catalog

# Tier-1 estate memory is ON by default (a local, derived, rebuildable SQLite beside the
# audit ledger — nothing leaves the box). Set to 0 to opt out; this also removes
# proximo_recall from the facade.
#PROXIMO_MEMORY=0

# --- Safety ---
# In-container exec (ssh -> pct) is OFF by default — Proximo is API-only and safe out of the box.
# Set to 1 ONLY if you want the exec edge; it grants near-root on the PVE host, so scope the
# ssh user and set a CTID allowlist below.
PROXIMO_ENABLE_EXEC=false

# Comma-separated CTIDs. Empty = DENY all (fail-closed). "*" = allow all (warns).
PROXIMO_CT_ALLOWLIST=

# Ledger redaction is ON by default: ct_exec / ct_psql / pve_agent_exec record a sha256
# fingerprint (+ kind + length) of the command or SQL rather than the body. The body routinely
# carries a secret — a password on the argv — and the PROVE ledger is a durable file, so the
# safe posture is the default. Set this to 0/false/off/no ONLY if you need the full body for
# forensics and accept credentials landing on disk; doing so warns loudly at startup.
# A value it does not recognise keeps redaction ON — a typo must never disable it.
#PROXIMO_LEDGER_REDACT=false

# --- qemu-agent (in-VM ops via the QEMU Guest Agent) ---
# OFF by default. Set to 1 ONLY to enable in-guest VM ops (exec / file read+write / fsfreeze /
# set-user-password). Like exec, it grants near-root INSIDE the guest, so scope the VMID allowlist.
# Requires the guest to have qemu-guest-agent installed + running (and agent=1 in the VM config).
PROXIMO_ENABLE_AGENT=false

# Comma-separated VMIDs. Empty = DENY all (fail-closed). "*" = allow all (warns).
# Independent of the CTID allowlist above — VM-agent ops and LXC exec are scoped separately.
PROXIMO_AGENT_ALLOWLIST=

# --- Arm (scoped write, off by default) ---
# Keep write authority OFF by default and switch it on per job with `proximo arm` /
# `proximo disarm`, which swap these two files into PROXIMO_TOKEN_PATH. Leave unset to
# skip the pattern entirely; the token at PROXIMO_TOKEN_PATH is then simply whatever
# you put there.
#PROXIMO_ARM_SOURCE=/etc/proximo/operator-token
#PROXIMO_READONLY_SOURCE=/etc/proximo/pve-token.readonly
# These two describe THIS box. If you also use the target registry (PROXIMO_TARGETS), give any
# exec-enabled target its own `arm_source` in that file — it is never inherited from here, and a
# target without one is refused rather than ridden in on this box's arm.
# Also: do not point PROXIMO_ARM_SOURCE at PROXIMO_TOKEN_PATH. One file for both roles makes the
# check compare a file to itself, which would read as ARMED forever; Proximo refuses that instead.
# With a session dir, each `--session KEY` gets its own token file, so arming one caller
# leaves the others read-only. Without it, all callers on this box share one arm state.
#PROXIMO_SESSION_DIR=/etc/proximo/sessions
#PROXIMO_SESSION_KEY=default
# LEASE: elapsed seconds after which an arm auto-expires (fail-closed). Unset = no expiry,
# so a forgotten `disarm` stays armed until someone runs it.
#PROXIMO_ARM_TTL=3600
# `proximo reap` puts the key back for sessions that ENDED while armed (a serving process holds
# a lock the OS drops when it dies, so no TTL is needed to spot one). This grace window protects
# a BRAND-NEW arm that has not been picked up by a server yet — it is a startup-race guard, not
# an expiry. A garbled value falls back to the 300s default, never to zero.
#PROXIMO_REAP_GRACE=300
# Opt-in: `reap` also unlinks session token+lock files that are read-only, unheld, and idle
# more than this many days (dead sessions otherwise accrete files forever). Unset or garbled =
# no unlinking — deletion is the destructive verb, so a typo must not enable it.
#PROXIMO_REAP_UNLINK_DAYS=7

PROXIMO_AUDIT_LOG=/var/log/proximo/audit.log
# PROVE ledger: keyed (HMAC) chaining is ON by default. Opt out with PROXIMO_AUDIT_KEYED=off.
# Key auto-generated 0600 at <audit-log-dir>/audit.key (override with PROXIMO_AUDIT_KEY_PATH).
# An existing unkeyed log is sealed + archived (never deleted) and a fresh keyed log started.
#PROXIMO_AUDIT_KEYED=off
#PROXIMO_AUDIT_KEY_PATH=/var/lib/proximo/audit.key
# Pin your ledger head OFF-BOX to detect tail truncation/forged-append/wipe (the strong guarantee).
# AUTOMATED pin (preferred): the anchor sink writes head() at startup and keeps it in step on
# audit_verify. Fail-closed: a configured-but-unreachable sink refuses to start.
# Trust model + placement guidance: SECURITY.md "PROVE: an off-box head anchor".
# Sink "file": a mount/store this box can write but not rewrite (an NFS export, an append-only path).
#PROXIMO_AUDIT_ANCHOR_SINK=file
#PROXIMO_AUDIT_ANCHOR_FILE_PATH=/mnt/offbox/proximo-audit-head.json
# Sink "http": GET/PUT one pin resource on a receiver on a DIFFERENT host (WebDAV location,
# object-store gateway, a ten-line receiver: GET returns the stored pin, 404 when empty, PUT stores).
# TLS verifies always (no off switch by design — this is the tamper channel); private CA supported;
# a plain http:// URL works but warns loudly. Bearer token by file reference, chmod 600.
#PROXIMO_AUDIT_ANCHOR_SINK=http
#PROXIMO_AUDIT_ANCHOR_URL=https://pins.example.lan/proximo/head
#PROXIMO_AUDIT_ANCHOR_TOKEN_PATH=/etc/proximo/anchor-token
#PROXIMO_AUDIT_ANCHOR_CA_BUNDLE=/etc/proximo/anchor-ca.crt
# Sink "syslog": the WRITE-ONLY witness — every clean audit_verify APPENDS the head to the
# collector's trail (append-only retention, off-box). It cannot read a pin back, so automatic
# tail detection needs EXPECTED_HEAD, a readable sink, or collector-side comparison (a startup
# warning says so when nothing covers it). Address = unix socket path (/dev/log) or host:port
# TCP; TCP speaks TLS when the CA_BUNDLE above is set, plaintext warns loudly; UDP is refused
# by design (a fire-and-forget publish cannot fail, so it cannot be a check).
#PROXIMO_AUDIT_ANCHOR_SINK=syslog
#PROXIMO_AUDIT_ANCHOR_SYSLOG_ADDRESS=collector.example.lan:6514
# journal = the same write-only witness on a systemd box, with nothing to stand up: heads are
# appended to the journal over its native protocol, inheriting the journal's retention,
# rotation and (where configured) FSS sealing. Read them with:
#   journalctl -t proximo-anchor -o json
# Same limit as syslog — it cannot hand a pin back, so cover automatic tail detection with
# EXPECTED_HEAD, a readable sink, or journal-side comparison. The socket path is fixed by
# systemd, so the override below exists mainly for testing.
#PROXIMO_AUDIT_ANCHOR_SINK=journal
#PROXIMO_AUDIT_ANCHOR_JOURNAL_SOCKET=/run/systemd/journal/socket
# MANUAL pin: read audit_verify's "head" field, store it somewhere the box can't rewrite, set:
#PROXIMO_AUDIT_EXPECTED_HEAD=<64-hex head() value>
# NOTE: enabling keyed mode on an existing unkeyed ledger rotates it to a NEW head — re-pin this
# after a keyed upgrade (the migration warning prints the new head).

# --- Principal (who-asked identity) — optional, records WHO asked on every ledger entry ---
# Declared name-tag for this instance (the operator's word, like the token). Stamped on every
# PROVE entry across all faces. Unset = entries carry no who-asked.
#PROXIMO_PRINCIPAL=claude-code@ops
# Network faces only: a directory of pinned public caller keys (<name>.jwk, EC P-256). When set,
# a caller must present a valid signed Proximo-Principal badge or be REFUSED (fail-closed); the
# verified name is recorded via:verified. Mint a caller's badge + pin file with `proximo badge mint`.
# Identity, not authority — a verified name never widens what a call may do; the token ACL is the boundary.
#PROXIMO_CALLER_KEYS_DIR=/etc/proximo/callers
PROXIMO_VERIFY_TLS=true
# Prefer a pinned bundle over disabling TLS verification. Point it at the NODE's own
# certificate rather than the cluster CA: Proxmox issues its cluster CA with CA:TRUE but
# no keyUsage extension, and a strict-verifying stack (Python 3.13 turns VERIFY_X509_STRICT
# on by default) rejects that CA outright with "CA cert does not include key usage
# extension". The node cert has no such problem, and Proximo pins it as a trust anchor in
# its own right, so it verifies on every interpreter.
# PROXIMO_CA_BUNDLE=/etc/proximo/pve-node.crt
# Or pin the node cert directly — WIRE-ENFORCED: the SHA-256 must match exactly (the form
# the PVE GUI shows), replacing CA/hostname validation. Strongest for a self-signed PVE node
# whose cert is signed by the per-cluster "PVE Cluster Manager CA" no public root trusts.
# PROXIMO_FINGERPRINT=AA:BB:CC:...

# --- PBS (Proxmox Backup Server) — optional, only needed for pbs_* tools ---
# PROXIMO_PBS_BASE_URL=https://pbs.example.lan:8007/api2/json
# PROXIMO_PBS_TOKEN_PATH=/etc/proximo/pbs-token
# PROXIMO_PBS_VERIFY_TLS=true
# PROXIMO_PBS_CA_BUNDLE=/etc/proximo/pbs-ca.crt
# Fingerprint pinning is WIRE-ENFORCED: when set, the server cert's SHA-256 must match
# exactly (the form the PBS GUI shows) — replaces CA/hostname validation, refuses on
# mismatch before the token is sent. The strongest option for a self-signed PBS box.
# PROXIMO_PBS_FINGERPRINT=AA:BB:CC:...

# --- PMG (Proxmox Mail Gateway) — optional, only needed for pmg_* tools ---
# Ticket-based auth confirmed against PMG 9.1 (cookie PMGAuthCookie, CSRF on writes, no API tokens).
# PROXIMO_PMG_BASE_URL=https://pmg.example.lan:8006/api2/json
# PROXIMO_PMG_PASSWORD_PATH=/etc/proximo/pmg-password
# PROXIMO_PMG_USERNAME=root@pam
# PROXIMO_PMG_NODE=pmg
# PROXIMO_PMG_VERIFY_TLS=true
# PROXIMO_PMG_CA_BUNDLE=/etc/proximo/pmg-ca.crt
# Or pin the cert (WIRE-ENFORCED — exact SHA-256 match, strongest for a self-signed PMG):
# PROXIMO_PMG_FINGERPRINT=AA:BB:CC:...

# --- PDM (Proxmox Datacenter Manager) — optional, only needed for pdm_* tools ---
# Auth: PDMAPIToken TOKENID:SECRET (space separator — not '=' like PVE/PBS)
# /api2/json is appended automatically if the URL has no path.
# PROXIMO_PDM_BASE_URL=https://pdm.example.com:8443
# PROXIMO_PDM_TOKEN_PATH=/etc/proximo/pdm-token
# PROXIMO_PDM_VERIFY_TLS=true
# PROXIMO_PDM_CA_BUNDLE=/etc/proximo/pdm-ca.crt
# Or pin the cert (WIRE-ENFORCED — exact SHA-256 match, strongest for a self-signed PDM):
# PROXIMO_PDM_FINGERPRINT=AA:BB:CC:...

# --- Network faces (A2A / HTTP / MCP-over-streamable-HTTP) — optional, opt-in per face ---
# Each face is its own command (proximo-a2a / proximo-http / proximo-mcp-http) and only
# listens when YOU start it — nothing in this section opens a port by itself. All three
# share one fail-closed perimeter (proximo.webguard): a non-localhost *_HOST REFUSES to
# start without its *_TOKEN_FILE (inbound bearer, run-but-not-read; chmod 600 — a separate
# secret from the Proxmox API tokens above: this one is what YOUR CLIENTS present to
# Proximo). *_ALLOWED_HOSTS is the Host allowlist for the DNS-rebind guard — set it to the
# hostname your reverse proxy forwards; an explicit list REPLACES the loopback default, so
# include localhost/the container name if healthchecks hit those. Setup walkthrough:
# SETUP.md "Remote / multi-client".

# A2A (Agent2Agent) — proximo-a2a, [a2a] extra
# PROXIMO_A2A_HOST=127.0.0.1
# PROXIMO_A2A_PORT=41241
# PROXIMO_A2A_TOKEN_FILE=/etc/proximo/a2a-bearer.token
# PROXIMO_A2A_ALLOWED_HOSTS=
# Sign the agent card (optional; EC P-256 private key, chmod 600):
# PROXIMO_A2A_SIGNING_KEY_FILE=/etc/proximo/a2a-signing.key

# HTTP/OpenAPI (REST for no-code clients) — proximo-http, [http] extra
# PROXIMO_HTTP_HOST=127.0.0.1
# PROXIMO_HTTP_PORT=41242
# PROXIMO_HTTP_TOKEN_FILE=/etc/proximo/http-bearer.token
# PROXIMO_HTTP_ALLOWED_HOSTS=

# MCP over Streamable HTTP (networked MCP clients, no bridge) — proximo-mcp-http, [mcp-http] extra
# PROXIMO_MCP_HTTP_HOST=127.0.0.1
# PROXIMO_MCP_HTTP_PORT=41243
# PROXIMO_MCP_HTTP_TOKEN_FILE=/etc/proximo/mcp-bearer.token
# PROXIMO_MCP_HTTP_ALLOWED_HOSTS=
# Stateless serving is the DEFAULT (multi-client behind a proxy is the deployment model).
# Opt out for session-stateful serving:
# PROXIMO_MCP_HTTP_STATELESS=0
# Answer POSTs with plain JSON instead of SSE, for clients that prefer it:
# PROXIMO_MCP_HTTP_JSON=1
