# Proximo — every setting the core reads, with its default. Copy to ~/.config/proximo/proximo.env
# (every door sources it first; PROXIMO_ENV_FILE to point elsewhere) or to a daemon's
# EnvironmentFile. A key the process environment already holds wins, and the door names a key
# the two stores hold with different values as SHADOWED at start. Only PROXIMO_* keys are read.
# Secrets are read by PATH, never inlined; a secret file anyone else can read is refused.

# --- Proxmox VE (the default plane) ---
PROXIMO_API_BASE_URL=https://pve.example.lan:8006/api2/json
# The SERVED token file: what the door dials with. `proximo mint pve` prints the runbook that
# makes a read token and copies it here; `proximo arm` / `proximo disarm` install the write or
# the read token's bytes INTO this file. It is never one of the two sources below.
PROXIMO_TOKEN_PATH=/etc/proximo/pve.served
# The read token itself, what `disarm` restores (message quality for the arm check, never enforcement):
PROXIMO_READONLY_SOURCE=/etc/proximo/pve-read.token
# The write token, at rest: armed means the served file's bytes equal this file's. Mint it scoped
# and expiring (`proximo mint pve --write --scope /vms/100 --expire 8h`): the vendor's ACL is the
# scope and its own `expire` is the lease; Proximo keeps neither.
#PROXIMO_ARM_SOURCE=/etc/proximo/pve-write.token
# TLS: pin the NODE's certificate (the cluster CA has no keyUsage and a strict stack refuses it),
# or its fingerprint (the form the GUI shows; wire-enforced, exact match). Never disable verification.
#PROXIMO_CA_BUNDLE=/etc/proximo/pve-node.crt
#PROXIMO_FINGERPRINT=AA:BB:CC:...

# --- PBS, PMG, PDM (optional planes; each is reachable only when configured) ---
#PROXIMO_PBS_BASE_URL=https://pbs.example.lan:8007/api2/json
#PROXIMO_PBS_TOKEN_PATH=/etc/proximo/pbs.served
#PROXIMO_PBS_READONLY_SOURCE=/etc/proximo/pbs-read.token
#PROXIMO_PBS_ARM_SOURCE=/etc/proximo/pbs-write.token      # PBS's own pair; PVE's never arms PBS
#PROXIMO_PBS_CA_BUNDLE=/etc/proximo/pbs-ca.crt
#PROXIMO_PBS_FINGERPRINT=AA:BB:CC:...                       # WIRE-ENFORCED: exact SHA-256 match, refuses before the token is sent
#PROXIMO_PMG_BASE_URL=https://pmg.example.lan:8006/api2/json
# PMG has no API tokens: a credential file of two lines, user@realm then the password. The
# identity rides in the file, so PMG's arm pair is the same shape, swapped by hand.
#PROXIMO_PMG_CREDENTIAL_PATH=/etc/proximo/pmg.served
#PROXIMO_PMG_READONLY_SOURCE=/etc/proximo/pmg-audit.credential
#PROXIMO_PMG_ARM_SOURCE=/etc/proximo/pmg-write.credential
#PROXIMO_PMG_CA_BUNDLE=/etc/proximo/pmg-ca.crt
#PROXIMO_PMG_FINGERPRINT=AA:BB:CC:...
#PROXIMO_PDM_BASE_URL=https://pdm.example.com:8443          # /api2/json is appended when the URL has no path
#PROXIMO_PDM_TOKEN_PATH=/etc/proximo/pdm.served
#PROXIMO_PDM_READONLY_SOURCE=/etc/proximo/pdm-read.token
#PROXIMO_PDM_ARM_SOURCE=/etc/proximo/pdm-write.token
#PROXIMO_PDM_CA_BUNDLE=/etc/proximo/pdm-ca.crt
#PROXIMO_PDM_FINGERPRINT=AA:BB:CC:...

# --- Many boxes, one Proximo ---
# A TOML registry of [targets.<name>] tables (see targets.example.toml); the three tools take
# target="<name>" and the shell door --target. Each target carries its own arm pair.
#PROXIMO_TARGETS=/etc/proximo/targets.toml

# --- PROVE: the ledger (keyed, always) ---
PROXIMO_AUDIT_LOG=/var/log/proximo/audit.log
# The HMAC key is minted 0600 beside the log on the first write; override its path here. An
# existing unkeyed log (a 0.44 opt-out) is sealed + archived (never deleted) and a keyed log started.
#PROXIMO_AUDIT_KEY_PATH=/var/lib/proximo/audit.key
# Pin the ledger head OFF-BOX to catch tail truncation, a forged append or a wipe: copy head()
# somewhere this box cannot write, and pass it back as expected_head (the chain must end there).
# Set here, it is a standing pin: a row the chain must still hold (catches a cut below it or a
# replaced file, not a row forged after it).
#PROXIMO_AUDIT_EXPECTED_HEAD=<64-hex head() value>

# --- CONSENT and CONTAIN: yours to raise, off until their path exists OUTSIDE the agent's reach ---
# A directory only the operator's hand writes: every mutation then needs a single-use grant file
# named by its plan's consent_id, expiring after the TTL (default 900 s, 15 minutes).
#PROXIMO_CONSENT_DIR=/etc/proximo/consent
#PROXIMO_CONSENT_TTL_SECONDS=900
# The kill-switch: while this file exists every mutation is refused, checked fresh per call.
#PROXIMO_CONTAIN_TRIP_PATH=/etc/proximo/CONTAIN

# --- The envelope: FORBID and RATE ---
# Addresses never to mutate, whatever the arm (substrings of "plane:METHOD /path", comma-separated):
#PROXIMO_FORBID=pve:DELETE /nodes,pve:POST /cluster/config
# At most N mutations per window of W seconds, reservations on disk, refused past the cap:
#PROXIMO_RATE_MAX=20
#PROXIMO_RATE_WINDOW=60

# --- UNDO ---
# ON: a mutation with a GET twin captures the record first or does not run. 0 opts out.
#PROXIMO_UNDO=0
# The download lane lands here; one fresh private directory per pull, 0600, capped.
#PROXIMO_RESTORE_DIR=~/.local/state/proximo/restores
#PROXIMO_RESTORE_MAX_BYTES=268435456

# --- TAINT: untrusted reads (guest logs, quarantine mail, free text) and what may follow them ---
# Track: reading an address the record marks untrusted sets a sticky marker beside the ledger and
# stamps untrusted:true on the row; the marker clears only out of band.
#PROXIMO_TAINT_TRACK=1
# Forbid: once tainted, these addresses are refused outright (no consent escape):
#PROXIMO_TAINT_FORBID=pve:PUT /cluster/firewall,pve:POST /access
# Require consent for any other tainted mutation (fail-closed without a consent dir):
#PROXIMO_TAINT_REQUIRE_CONSENT=1
# Fence: wrap untrusted output in a labelled envelope (advisory; a hijacked agent can ignore it).
#PROXIMO_TAINT_FENCE=1

# --- The lanes that touch this host or a guest (each OFF until opened; each judged like a mutation) ---
# Container exec: `pct exec` over a non-interactive ssh hop to the node the path names.
#PROXIMO_ENABLE_EXEC=1
#PROXIMO_CT_ALLOWLIST=101,102            # CTIDs, or * (the allowlist is required; unset refuses)
#PROXIMO_SSH_TARGET=pve                  # the ssh alias of the node; no default, unset refuses
# The in-guest agent (QEMU guest agent): root inside the listed VMs.
#PROXIMO_ENABLE_AGENT=1
#PROXIMO_AGENT_ALLOWLIST=200,201
# The host's own read-only battery (journal, service state) under a node's diagnosis.
#PROXIMO_ENABLE_NODE_SHELL=1
# The download lane: the five byte-stream reads land on this host under PROXIMO_RESTORE_DIR.
#PROXIMO_ENABLE_DOWNLOAD=1
# A raw read's answer is cut at this many bytes (lean rows first; fields= gets rows).
#PROXIMO_RAW_MAX_BYTES=6144

# --- Store: "what changed since" from the door's own snapshots of every list read ---
#PROXIMO_STORE=0                          # on by default; 0 opts out (since= then refuses)
#PROXIMO_STORE_DIR=/var/lib/proximo/store # default: store/ beside the ledger

# --- PRINCIPAL: who asked, on every row (identity, never authority) ---
#PROXIMO_PRINCIPAL=claude-code@ops
# Network doors only: a directory of pinned caller keys (<name>.jwk, EC P-256). When set, a caller
# must present a signed Proximo-Principal badge (`proximo badge mint`) or is refused.
#PROXIMO_CALLER_KEYS_DIR=/etc/proximo/callers

# --- The network doors (each is its own command and listens only when YOU start it) ---
# One fail-closed perimeter: a non-localhost *_HOST REFUSES to start without its *_TOKEN_FILE (the
# bearer YOUR CLIENTS present, chmod 600, a separate secret from the Proxmox tokens). *_ALLOWED_HOSTS
# is the Host allowlist for the DNS-rebind guard: set it to the hostname a reverse proxy forwards;
# an explicit list REPLACES the loopback default.
#PROXIMO_MCP_HTTP_HOST=127.0.0.1           # proximo-mcp-http, [mcp-http] extra
#PROXIMO_MCP_HTTP_PORT=41243
#PROXIMO_MCP_HTTP_TOKEN_FILE=/etc/proximo/mcp-bearer.token
#PROXIMO_MCP_HTTP_ALLOWED_HOSTS=proximo.example.lan,localhost
#PROXIMO_MCP_HTTP_STATELESS=0              # default 1: stateless, multi-client behind a proxy
#PROXIMO_MCP_HTTP_JSON=1                   # answer POSTs with plain JSON instead of SSE
#PROXIMO_HTTP_HOST=127.0.0.1               # proximo-http, [http] extra: POST /tools/{name}, /openapi.json
#PROXIMO_HTTP_PORT=41242
#PROXIMO_HTTP_TOKEN_FILE=/etc/proximo/http-bearer.token
#PROXIMO_HTTP_ALLOWED_HOSTS=proximo.example.lan,localhost
#PROXIMO_A2A_HOST=127.0.0.1                # proximo-a2a, [a2a] extra: the card's skills are the six tools
#PROXIMO_A2A_PORT=41241
#PROXIMO_A2A_TOKEN_FILE=/etc/proximo/a2a-bearer.token
#PROXIMO_A2A_ALLOWED_HOSTS=proximo.example.lan,localhost
#PROXIMO_A2A_SIGNING_KEY_FILE=/etc/proximo/a2a-signing.pem   # signs the card; JWKS served beside it

# --- Retired (a door refuses to start while any of these is set) ---
# PROXIMO_SCOPE_PATH and PROXIMO_ARM_TTL went to the vendor (the write token's ACL and expire);
# PROXIMO_AUDIT_KEYED=off went with the unkeyed ledger (0.45). PROXIMO_SURFACES: the core has none.
