      "mimeType": "image/png",
      "sizes": ["256x256"]
    },
    {
      "src": "https://raw.githubusercontent.com/john-broadway/proximo/main/docs/brand/proximo-favicon-64.png",
      "mimeType": "image/png",
      "sizes": ["64x64"]
    },
    {
      "src": "https://raw.githubusercontent.com/john-broadway/proximo/main/docs/brand/proximo-mark.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    }
  ],
  "repository": {
    "url": "https://github.com/john-broadway/proximo",
    "source": "github"
  },
  "version": "0.50.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "proximo-proxmox",
