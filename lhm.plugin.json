{
  "identifier": "john-broadway-proximo",
  "name": "Proximo — the Proxmox MCP you can hand the keys",
  "description": "The Proxmox MCP you can hand the keys: VE/PBS/PMG/PDM. Plan, prove, undo, diagnose. MCP/A2A/API.",
  "version": "0.47.0",
  "tools": [
    {
      "name": "proximo_find",
      "description": "READ-ONLY: search every API address the planes publish, in plain words ('list datastores', 'guest status'). A verb picks the method; other words match the path, the vendor's description, parameter names. 5 by default. Returns access and the authored blast-radius tier.",
      "inputSchema": {
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "plane": {
            "anyOf": [
              {
                "enum": [
                  "pve",
                  "pbs",
                  "pmg",
                  "pdm"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Plane"
          },
          "limit": {
            "default": 5,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "type": "object",
        "title": "findArguments"
      }
    },
    {
      "name": "proximo_plan",
      "description": "READ-ONLY: the governed verdict for one address and the vendor's published parameters. Mutates nothing. A mutation's plan also reads the target (one governed read, receipted): current, change (from/to per argument), noop. Run before proximo_call. path may be words: one match is planned, several come back to pick from.",
      "inputSchema": {
        "properties": {
          "plane": {
            "enum": [
              "pve",
              "pbs",
              "pmg",
              "pdm"
            ],
            "title": "Plane",
            "type": "string"
          },
          "method": {
            "title": "Method",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "args": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Args"
          }
        },
        "required": [
          "plane",
          "method",
          "path"
        ],
        "type": "object",
        "title": "_planArguments"
      }
    },
    {
      "name": "proximo_read",
      "description": "READ-ONLY: run any GET the plane publishes, by path. Rows come back LEAN with a total (names, states, ids) unless fields='all' or fields='name,status'. Over the cap: counts per state and the odd rows; fields= gets rows. since='24h' (30m, 7d): what changed, from the door's own snapshots, no vendor call. Credentials come back withheld. wait=N on a .../tasks/{upid}/status address waits up to N s (max 600) for the task's end. diagnose=true on a node or guest path: its health reads and advisory flags, one call.",
      "inputSchema": {
        "properties": {
          "plane": {
            "enum": [
              "pve",
              "pbs",
              "pmg",
              "pdm"
            ],
            "title": "Plane",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "params": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Params"
          },
          "fields": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Fields"
          },
          "since": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Since"
          },
          "wait": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Wait"
          },
          "diagnose": {
            "default": false,
            "title": "Diagnose",
            "type": "boolean"
          }
        },
        "required": [
          "plane",
          "path"
        ],
        "type": "object",
        "title": "_readArguments"
      }
    },
    {
      "name": "proximo_call",
      "description": "MUTATION: run a governed POST/PUT/DELETE. Dry-run by default: without confirm=true it returns the plan (verdict, consent id, current, change) and mutates nothing. Refused unless the operator is armed AND the address carries an authored blast-radius tier. Every call, refused or executed, is receipted. A task-backed call is waited on (wait=N s, default 60, max 600; 0 submits only) and reports finished, failed or timed out under 'task'. method=undo with path=<undo.id> puts that receipt's capture back through the vendor's PUT, plan first; withheld or unpublished keys come back as skipped.",
      "inputSchema": {
        "properties": {
          "plane": {
            "enum": [
              "pve",
              "pbs",
              "pmg",
              "pdm"
            ],
            "title": "Plane",
            "type": "string"
          },
          "method": {
            "title": "Method",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "args": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Args"
          },
          "confirm": {
            "default": false,
            "title": "Confirm",
            "type": "boolean"
          },
          "wait": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Wait"
          }
        },
        "required": [
          "plane",
          "method",
          "path"
        ],
        "type": "object",
        "title": "_callArguments"
      }
    },
    {
      "name": "audit_entries",
      "description": "READ-ONLY: read the PROVE ledger back, newest first, bounded, rows with ids; says when it truncated.",
      "inputSchema": {
        "properties": {
          "limit": {
            "default": 20,
            "title": "Limit",
            "type": "integer"
          },
          "target": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Target"
          },
          "action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Action"
          },
          "mutations_only": {
            "default": false,
            "title": "Mutations Only",
            "type": "boolean"
          }
        },
        "type": "object",
        "title": "audit_entriesArguments"
      }
    },
    {
      "name": "audit_verify",
      "description": "READ-ONLY: walk the chain and report the first break; expected_head catches a cut tail; path=<archive> verifies a sealed archive beside the ledger.",
      "inputSchema": {
        "properties": {
          "expected_head": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Expected Head"
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Path"
          }
        },
        "type": "object",
        "title": "audit_verifyArguments"
      }
    }
  ]
}
